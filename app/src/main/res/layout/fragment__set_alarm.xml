<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/black"
    android:orientation="vertical"
    tools:context=".fragment_SetAlarm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <Space
            android:layout_width="wrap_content"
            android:layout_height="3dp"></Space>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <NumberPicker
                    android:id="@+id/ID_PickerAlarms"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_marginLeft="50dp"></NumberPicker>

                <Space
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"></Space>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/ID_ButtonSave"
                        android:layout_width="150dp"
                        android:layout_height="50dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="10dp"
                        android:layout_weight="0.33"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/ID_ButtonImageSave"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/disable"></ImageView>

                        <TextView
                            android:id="@+id/ID_ButtonTextSave"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="Save"
                            android:textColor="@color/white"
                            android:textSize="20dp"
                            android:textStyle="bold"></TextView>

                    </FrameLayout><!-- Finish create new image button -->
                    <FrameLayout
                        android:id="@+id/ID_ButtonOverWrite"
                        android:layout_width="150dp"
                        android:layout_height="50dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="10dp"
                        android:layout_weight="0.33"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/ID_ButtonImageOverWrite"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/disable"></ImageView>

                        <TextView
                            android:id="@+id/ID_ButtonTextOverWrite"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="Overwrite"
                            android:textColor="@color/white"
                            android:textSize="20dp"
                            android:textStyle="bold"></TextView>

                    </FrameLayout><!-- Finish create new image button -->
                    <FrameLayout
                        android:id="@+id/ID_ButtonAbort"
                        android:layout_width="150dp"
                        android:layout_height="50dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="10dp"
                        android:layout_weight="0.33"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/ID_ButtonImageAbort"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/disable"></ImageView>

                        <TextView
                            android:id="@+id/ID_ButtonTextAbort"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="Abort"
                            android:textColor="@color/white"
                            android:textSize="20dp"
                            android:textStyle="bold"></TextView>

                    </FrameLayout><!-- Finish create new image button -->


                </LinearLayout>
            </LinearLayout>

            <Space
                android:layout_width="wrap_content"
                android:layout_height="8dp"></Space>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <CheckBox
                            android:id="@+id/ID_CheckBoxMonday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/checkbox_state"
                            android:text="Monday"
                            android:textColor="@color/white"
                            android:textSize="25dp"></CheckBox>

                        <CheckBox
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/checkbox_state"
                            android:text="Tuesday"
                            android:textColor="@color/white"
                            android:textSize="25dp"></CheckBox>

                        <CheckBox
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/checkbox_state"
                            android:text="Wednesday"
                            android:textColor="@color/white"
                            android:textSize="25dp"></CheckBox>

                        <CheckBox
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/checkbox_state"
                            android:text="Thursday"
                            android:textColor="@color/white"
                            android:textSize="25dp"></CheckBox>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <CheckBox
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/checkbox_state"
                            android:text="Saturday"
                            android:textColor="@color/white"
                            android:textSize="25dp"></CheckBox>

                        <CheckBox
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/checkbox_state"
                            android:text="Sunday"
                            android:textColor="@color/white"
                            android:textSize="25dp"></CheckBox>

                        <CheckBox
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/checkbox_state"
                            android:text="Friday"
                            android:textColor="@color/white"
                            android:textSize="25dp"></CheckBox>

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:text="Hora (24h):"
                        android:textColor="@color/white"
                        android:textSize="16sp"></TextView>

                    <NumberPicker
                        android:id="@+id/ID_NumbPickHours"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"></NumberPicker>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"></TextView>

                    <NumberPicker
                        android:id="@+id/ID_NumbPickMinutes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"></NumberPicker>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"></TextView>


                    <NumberPicker
                        android:id="@+id/ID_NumbPickSeconds"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"></NumberPicker>

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="wrap_content"></Space>

                    <NumberPicker
                        android:id="@+id/ID_NumbPickAmPm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"></NumberPicker>


                </LinearLayout>

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Output1"
                        android:textColor="@color/white"></TextView>


                    <Spinner
                        android:id="@+id/ID_SpinnerOutput1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:entries="@array/output_selector_options"
                        android:spinnerMode="dropdown"></Spinner>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Output2"
                        android:textColor="@color/white"></TextView>


                    <Spinner
                        android:id="@+id/ID_SpinnerOutput2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:entries="@array/output_selector_options"
                        android:spinnerMode="dropdown"></Spinner>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Output3"
                        android:textColor="@color/white"></TextView>


                    <Spinner
                        android:id="@+id/ID_SpinnerOutput3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:entries="@array/output_selector_options"
                        android:spinnerMode="dropdown"></Spinner>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
